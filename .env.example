# Khóa API Google AI Studio (Gemini) — Bắt buộc khi chạy chế độ Live (không cần nếu chạy --dry-run)
GEMINI_API_KEY=your_gemini_api_key_here

# Cấu hình Model mặc định (tối ưu chi phí trên mỗi triệu token)
GEMINI_TRIAGE_MODEL=gemini-2.5-flash-lite
GEMINI_MULTIMODAL_MODEL=gemini-2.5-flash
GEMINI_PORTFOLIO_MODEL=gemini-2.5-flash

# Tỷ giá quy đổi tham chiếu sang VNĐ để hiển thị báo cáo
USD_TO_VND_RATE=25500

# Giới hạn luồng xử lý song song
MAX_LLM_CONCURRENCY=4
MAX_MEDIA_CONCURRENCY=2
